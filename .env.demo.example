# Environment für die öffentliche Demo-Instanz (compose.demo.yml).
# Auf dem Server nach `.env.demo` kopieren und Werte setzen.
# NICHT in Git committen!
#
# Anders als im Normalbetrieb werden hier KEINE GitLab-Zugangsdaten gebraucht:
# im Demo-Modus gibt es keine GitLab-Gegenstelle.

# ── Datenbank ─────────────────────────────────────────────────
POSTGRES_USER=taktline
POSTGRES_PASSWORD=
POSTGRES_DB=taktline_demo

# ── App ───────────────────────────────────────────────────────
# Öffentliche URL inklusive Schema. Wichtig: bei https muss hier auch https
# stehen — davon hängt der Name des Session-Cookies ab (__Secure--Präfix).
AUTH_URL=https://demo.example.com

# Secret für die Session-Signatur — generieren mit `openssl rand -base64 32`
AUTH_SECRET=

# Wird im Demo-Modus nicht wirksam (es werden keine OAuth-Tokens abgelegt),
# muss aber ein gültiger 32-Byte-Base64-Wert sein:
# `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# ── Demo-Verhalten ────────────────────────────────────────────
# Alle Besucher teilen sich einen Datenstand. Dieser Wert bestimmt, wie oft
# er auf die Beispieldaten zurückgesetzt wird. 0 = nie.
DEMO_RESET_INTERVAL_MINUTES=60

# ── Sonstiges ─────────────────────────────────────────────────
APP_PORT=3043
LOG_LEVEL=info

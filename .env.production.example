# Production-Environment für compose.prod.yml.
# Auf der Deploy-VM nach `.env.production` kopieren und Werte setzen.
# NICHT in Git committen!

# ── Datenbank ─────────────────────────────────────────────────
POSTGRES_USER=taktline
POSTGRES_PASSWORD=
POSTGRES_DB=taktline

# ── App ───────────────────────────────────────────────────────
# Öffentlicher URL (durch Traefik exposed). Wichtig für GitLab OAuth Redirect.
AUTH_URL=http://taktline.intern.example
# Falls Webhooks an einer anderen URL ankommen (z.B. wenn Traefik internal anders routet):
# WEBHOOK_PUBLIC_URL=http://taktline.intern.example

# Secrets — generieren mit `openssl rand -base64 32`
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# ── GitLab ────────────────────────────────────────────────────
GITLAB_URL=https://gitlab.example.com

# Production-OAuth-Application in GitLab Admin anlegen (oder die Dev-App mit
# zusätzlicher Redirect-URI ergänzen: ${AUTH_URL}/api/auth/callback/gitlab)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ── Reconciliation (Hintergrund-Re-Sync gegen GitLab) ─────────
# Fängt verlorene Webhooks ab (Network-Ausfall, Container-Restart etc.)
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MINUTES=15
# Secret zum manuellen Triggern via POST /api/admin/reconcile
# Generieren mit: openssl rand -hex 32
RECONCILIATION_SECRET=

# ── Sonstiges ─────────────────────────────────────────────────
APP_PORT=3043
LOG_LEVEL=info

# Datenbank
DATABASE_URL="postgresql://gantt:gantt@localhost:5433/gantt?schema=public"

# Auth.js
# Generieren mit: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3043"

# GitLab OAuth
# OAuth Application im GitLab anlegen:
#   User Settings (oder Admin) -> Applications
#   Redirect URI: ${AUTH_URL}/api/auth/callback/gitlab
#   Scopes: read_user, api
GITLAB_URL="https://gitlab.example.com"
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""

# Verschlüsselung der OAuth-Tokens in der DB (32 Byte, base64)
# Generieren mit: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Logging
LOG_LEVEL="info"
NODE_ENV="development"

# Reconciliation-Job (Hintergrund-Re-Sync gegen GitLab, fängt verlorene Webhooks ab)
# Standard: alle 15 Minuten, aktiviert in production. Auf "false" für Dev/Testing.
RECONCILIATION_ENABLED="true"
RECONCILIATION_INTERVAL_MINUTES="15"
# Optional: Secret zum manuellen Triggern via POST /api/admin/reconcile
# Generieren mit: openssl rand -hex 32
RECONCILIATION_SECRET=""
